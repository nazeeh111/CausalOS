include LICENSE README.md CONTRIBUTING.md CITATION.cff requirements-lock.txt
recursive-include sql *.sql
recursive-include examples *.py *.md *.json *.png
recursive-include benchmarks *.md *.json *.csv *.png *.svg
recursive-include docs *.md *.bib
